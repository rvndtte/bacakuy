# Supabase project (Dashboard > Project Settings > API)

# Used by the browser to upload PDFs directly to Supabase Storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-public-key

# Used by the serverless API (api/index.js) to talk to Supabase Auth/DB/Storage.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Only needed if the frontend and API are deployed to different domains.
# Leave unset when both are served from the same Vercel project.
# VITE_API_URL=https://your-api-domain.example.com

# Optional local server port
PORT=3001
