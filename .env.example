# Turso serverless database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

# Supabase serverless database (recommended alternative)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Used by the Vercel frontend to reach the deployed API
VITE_API_URL=https://your-api-domain.example.com

# Optional local server port
PORT=3001
